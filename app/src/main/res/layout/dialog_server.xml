<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/in_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_field"
        android:hint="@string/server_name_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#FFE6E9EF"
        android:textColorHint="#FF6B7280"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/in_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field"
        android:hint="@string/server_url_hint"
        android:imeOptions="actionDone"
        android:inputType="textUri|textNoSuggestions"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#FFE6E9EF"
        android:textColorHint="#FF6B7280"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txt_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="Leave the path empty to open the default workspace, or add one: http://host:8080/?folder=/home/me/projects"
        android:textColor="#FF7F8895"
        android:textSize="12sp" />
</LinearLayout>
